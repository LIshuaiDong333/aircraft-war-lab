@startuml
'https://plantuml.com/class-diagram

interface RankDao{
    + add(Rank rank): void
    + select(): List<Rank>
    + delete(int index): void
}

class RankDaoImpl{
    - rankList: List<Rank>
    - dataFilePath: String
    - rankComparator: Comparator<Rank>
    + RankDaoImpl(String dataFilePath)
    + add(Rank rank): void
    + select(): List<Rank>
    + delete(int index): void
    - loadFromFile(): List<Rank>
    - saveToFile(): void
}

class Rank{
    - name: String
    - score: int
    - time: long
    + Rank()
    + Rank(String name, int score, long time)
    + getName(): String
    + getScore(): int
    + getTime(): long
}

class GameTemplate{}

RankDao <|.. RankDaoImpl
Rank <-- RankDaoImpl
RankDao <.. GameTemplate

@enduml